[node name="SonidoDerrota" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5")
bus = &"Efectos"

[connection signal="pressed" from="PanelPausa/Caja/Continuar" to="." method="_on_continuar_pressed"]
[connection signal="pressed" from="PanelPausa/Caja/Menu" to="." method="_on_menu_pressed"]
[connection signal="pressed" from="PanelFin/Caja/Botones/Siguiente" to="." method="_on_siguiente_pressed"]
[connection signal="pressed" from="PanelFin/Caja/Botones/Reintentar" to="." method="_on_reintentar_pressed"]
[connection signal="pressed" from="PanelFin/Caja/Botones/Menu" to="." method="_on_menu_pressed"]
[connection signal="timeout" from="TimerVolverMenu" to="." method="_on_timer_volver_menu_timeout"]
